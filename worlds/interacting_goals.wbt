DEF PRECISION_LIGHT Solid {
  translation 0.500000 0.280000 0.085000
  rotation 0 0 1 3.14159265359
  children [
    DEF PRECISION_SPOT SpotLight {
      location 0.030 0 0
      direction 1 0 -0.08
      color 1 0.82 0.18
      intensity 8.500
      ambientIntensity 0
      attenuation 1 0.20 0.08
      radius 5
      beamWidth 0.045000
      cutOffAngle 0.070000
      castShadows FALSE
    }
    # Visual-only beam wedge. The supervisor updates its far width to match the
    # optical cut-off angle. It has no light source and no bounding object.
    Shape {
      appearance Appearance {
        material DEF PRECISION_BEAM_MAT Material {
          ambientIntensity 0
          diffuseColor 1 0.74 0.12
          emissiveColor 0.82 0.47 0.018
          transparency 0.74
        }
      }
      geometry IndexedFaceSet {
        coord DEF PRECISION_BEAM_COORD Coordinate {
          point [
            0.030 -0.016 0
            0.030  0.016 0
            0.600  0.050 0
            0.600 -0.050 0
          ]
        }
        coordIndex [ 0 1 2 3 -1 ]
      }
    }
    Pose {
      translation -0.020 0 0
      rotation 0 1 0 1.57079632679
      children [ Shape { appearance PBRAppearance { baseColor 0.015 0.017 0.021 roughness 0.38 metalness 0.28 } geometry Cylinder { height 0.065 radius 0.045 subdivision 32 } } ]
    }
    Pose {
      translation 0.014 0 0
      rotation 0 1 0 1.57079632679
      children [ Shape { appearance PBRAppearance { baseColor 1 0.72 0.05 emissiveColor 1 0.70 0.04 roughness 0.12 metalness 0 } geometry Cylinder { height 0.010 radius 0.038 subdivision 32 } } ]
    }
  ]
  name "natural-width jumping lure"
}
Robot { children [ ] name "AB obstacle precision lure supervisor" controller "light_stimulus" supervisor TRUE }
