#VRML_SIM R2025a utf8
# FUZZY6 v1.0: six sensory OOS paths -> six distributed bank channels -> motor readout.
WorldInfo {
  info [
    "A/B/AB obstacle precision world: same moving-light precision setup plus static dispersed obstacles around the robot."
    "The light beam is intentionally broad enough to illuminate one whole front side of the robot, rather than a single photosensor point."
    "The actual SpotLight is aimed in 3D at the nearer front-side photosensor and the visible wedge reflects the optical spread."
    "When heading and approach become stably aligned, the active lure switches off and reappears on the opposite side, forcing a new turn."
  ]
  title "A/B/AB obstacle precision test — moving light + dispersed objects"
  basicTimeStep 16
  contactProperties [
    ContactProperties { material1 "course_floor" material2 "wheel" coulombFriction [1.2] bounce 0 }
    ContactProperties { material1 "course_floor" material2 "robot_body" coulombFriction [0.08] bounce 0 }
    ContactProperties { material1 "wall" material2 "robot_body" coulombFriction [0.25] bounce 0 }
    ContactProperties { material1 "obstacle" material2 "robot_body" coulombFriction [0.30] bounce 0 }
  ]
}
